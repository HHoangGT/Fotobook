{
  "name": "fotobook-albums-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",
    "database.hostname": "postgres",
    "database.port": "5432",
    "database.user": "replication_user",
    "database.password": "replication_password",
    "database.dbname": "fotobook_development",
    "database.server.name": "fotobook",
    "table.include.list": "public.albums",
    "topic.prefix": "fotobook",
    "schema.history.internal.kafka.bootstrap.servers": "kafka-1:29092,kafka-2:29092,kafka-3:29092",
    "schema.history.internal.kafka.topic": "fotobook.schema-changes.albums",
    "transforms": "unwrap,route",
    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    "transforms.unwrap.drop.tombstones": "false",
    "transforms.unwrap.delete.handling.mode": "rewrite",
    "transforms.unwrap.add.fields": "op,source.ts_ms",
    "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.route.regex": "fotobook.public.albums",
    "transforms.route.replacement": "fotobook.albums",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "true",
    "value.converter.schemas.enable": "true",
    "snapshot.mode": "initial",
    "snapshot.locking.mode": "minimal",
    "slot.name": "debezium_albums",
    "publication.name": "debezium_publication",
    "plugin.name": "pgoutput",
    "topic.retention.ms": "604800000",
    "topic.retention.bytes": "-1"
  }
}